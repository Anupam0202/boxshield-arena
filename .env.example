# Runtime mode: replay | mock | live
AI_MODE=replay
# Use either GEMINI_API_KEY or GOOGLE_API_KEY for live mode. Never commit values.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_ATTACKER=
GEMINI_MODEL_DEFENDER=
GEMINI_MODEL_JUDGE=
# Generate a high-entropy production key; local development can use ephemeral state.
RUN_STATE_SIGNING_KEY=
LIVE_MODE_ENABLED=false
# Store only a one-way hash of a demo access code.
LIVE_DEMO_TOKEN_HASH=
MAX_AI_CALLS_PER_RUN=24
MAX_LIVE_RUNS_PER_MINUTE=2
LOG_LEVEL=INFO
PORT=8080
APP_BASE_URL=http://localhost:8080
