    "version": "1.0.0",
    "status": "PROPOSED",
    "summary": "Fence untrusted context, constrain actions, redact synthetic markers, and bound execution.",
    "operations": [
      {
        "name": "enableInputSanitizer",
        "value": true,
        "reason": "Detect direct and obfuscated instruction overrides.",
        "utilityRisk": "May flag unusual but legitimate phrasing."
      },
      {
        "name": "enableContextFencing",
        "value": true,
        "reason": "Keep document text in a non-authoritative data boundary.",
        "utilityRisk": "Low."
      },
      {
        "name": "enforceActionAllowlist",
        "value": [
          "lookup_order",
          "issue_demo_refund",
          "send_demo_message"
        ],
        "reason": "Reject unsupported actions deterministically.",
        "utilityRisk": "New actions require explicit registration."
      },
      {
        "name": "requireApprovalForActions",
        "value": [
          "issue_demo_refund",
          "send_demo_message"
        ],
        "reason": "Prevent excessive agency.",
        "utilityRisk": "Adds a confirmation step."
      },
      {
        "name": "denyActions",
        "value": [
          "delete_demo_record"
        ],
        "reason": "Prohibit destructive action in this target.",
        "utilityRisk": "None for supported workflow."
      },
      {
        "name": "setMaximumActionCalls",
        "value": 3,
        "reason": "Bound tool and cost usage.",
        "utilityRisk": "Long legitimate workflows may need a higher reviewed limit."
      },
      {
        "name": "addSyntheticCanaryRedactor",
        "value": [
          "BX_DEMO_CANARY_7F3A",
          "BX_INTERNAL_CONTEXT_MARKER_42"
        ],
        "reason": "Prevent demo-marker disclosure.",
        "utilityRisk": "Exact marker strings are redacted."
